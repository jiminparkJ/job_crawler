# Application
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# PostgreSQL (Docker Compose uses these too)
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=jobhunter
POSTGRES_DB=jobhunter
POSTGRES_PORT=5432
# App connection string (override for docker-compose internal host `postgres`)
DATABASE_URL=postgresql://jobhunter:jobhunter@localhost:5432/jobhunter?schema=public

# Scheduler
POLL_INTERVAL_MINUTES=45

# Telegram (optional until M6; fill with your bot token)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI matching (optional; e.g. OpenAI)
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
